# Copy this to .env.local for local dev, and set the same values in
# Vercel's Environment Variables panel for production.

# From your Anthropic Console (console.anthropic.com) — keep this SERVER-SIDE
# ONLY. It's read by the API routes in app/api/claude/*, never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# From your Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Also from Project Settings → API — the "service_role" secret key, NOT the
# anon key. Keep this SERVER-SIDE ONLY (same rule as ANTHROPIC_API_KEY — it
# bypasses RLS entirely). Used only by app/api/admin/* routes: inviting a new
# VA/Editor or Creative Director into real Supabase Auth, and the Admin
# Panel's Danger Zone data reset.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Only set once you've created the webhook in Fathom's dashboard pointed at
# https://your-domain/api/webhooks/fathom — Fathom gives you this secret at
# creation time. Leave blank until then; the webhook route safely no-ops
# (401) rather than erroring when it's unset.
FATHOM_WEBHOOK_SECRET=whsec_...

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application). Powers "Connect Google Drive"
# on the Integrations page — each CLIENT authorizes with their own Google
# account, so scripts get their Drive folder created in THEIR Drive, not a
# shared one. Leave both blank to disable — Connect just shows an error
# until they're set. See db/migration_003_google_drive.sql for the schema
# this needs, and lib/google-drive.ts for how it's used.
#   1. Enable the "Google Drive API" for the project.
#   2. OAuth consent screen: External, add the "drive.file" scope, and add
#      each client's Google account under Test users while the app is in
#      Testing mode (or submit for verification to lift the ~100-user cap).
#   3. Authorized redirect URI: https://your-domain/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Discord bot token (Discord Developer Portal → your app → Bot → Token) and
# the category ID your clients' 1-on-1 channels live under (Discord →
# Developer Mode → right-click the category → Copy Category ID). Powers
# auto-delivering call recaps to the right channel by matching the client's
# name against the channels in that category. Leave both blank to disable —
# recap delivery just skips Discord if unset.
DISCORD_BOT_TOKEN=
DISCORD_SUPPORT_CATEGORY_ID=
# Only needed if the bot is in more than one Discord server — leave blank
# and it auto-detects the single server it's in.
DISCORD_GUILD_ID=

# Optional — sends a branded recap email to the client via Resend
# (resend.com). Leave blank to skip; redundant if Fathom already emails
# call participants directly.
RESEND_API_KEY=
EMAIL_FROM=

# OPTIONAL org-wide fallback for "Break down this reference" on a script
# (app/api/claude/analyze-reference). Normally each client connects their
# OWN free-tier key from socialkit.dev under Integrations → SocialKit — 20
# breakdowns/month each, no card, and no cost to you. This env var only
# gets used for clients who haven't connected their own, so leave it blank
# unless you specifically want to cover everyone on one paid key.
SOCIALKIT_API_KEY=

# From apify.com (Settings → API & Integrations → Personal API token).
# Strongly recommended if you use Viral Alerts. SocialKit bills one request
# per creator per check against a 20/month free tier, so watching 4 creators
# buys only ~5 checks for the whole month. Apify bills per RESULT, fetches
# every tracked Instagram creator in ONE call, and renews $5 of credit every
# month with no card — roughly 48 checks/month for 4 creators, still free.
# Leave blank to keep using SocialKit for creator feeds. Transcripts (the
# Breakdown tool) always use SocialKit either way; they're low-volume enough
# that its free tier comfortably covers them.
APIFY_API_TOKEN=

# Optional, LOCAL DEV ONLY — absolute path to an Obsidian vault on this
# machine's disk. Writes a companion note per recap into
# "<vault>/01 Coaching Calls/". Only works when this server process can see
# that path, which is true for `npm run dev` on your own computer and NOT
# true once deployed to Vercel or any other host — leave unset in
# production, or set to a path only your local machine has.
OBSIDIAN_VAULT_PATH=
