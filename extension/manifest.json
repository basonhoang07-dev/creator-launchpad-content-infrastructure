{
  "manifest_version": 3,
  "name": "Auto Doomscroller",
  "version": "1.0.0",
  "description": "Doomscroll with a purpose: flags creators you already track as you scroll Instagram and TikTok, and saves any Reel or TikTok into Creator Launchpad in one click.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://creator-launchpad-content-infrastru.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Doomscroller"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
